# The history service's passwords: copy this file to `.env.history` at the repo root (git-ignored)
# and fill it in. compose.yml loads it into `history` and `history-backup` only (docs/SERVER.md §3.6).
#
# Generate each with:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# The bot passwords take effect only when the history volume is created (the first start); after
# that, changing one here changes nothing. Each bot's .env.<bot> holds its own password inside
# HISTORY_URL, and must match.

# The Postgres superuser (used only to create the databases and by the nightly backup).
POSTGRES_PASSWORD=

# The crypto_history role: HISTORY_URL in .env.crypto.
CRYPTO_HISTORY_PASSWORD=

# The stock_history role: HISTORY_URL in .env.stock.
STOCK_HISTORY_PASSWORD=
