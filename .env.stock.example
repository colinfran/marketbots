# StockMarketBot configuration: copy this file to `.env.stock` at the repo root (git-ignored) and fill it in.
#
# One file holds everything the stock engine and the stock dashboard read:
#   • Engine (trading server): compose.yml loads .env.stock into the stock-engine container (env_file).
#     compose.yml itself sets STREAM_HOST, STREAM_PORT, SCRAPER_URL, LLM_URL and SEARCH_URL.
#     It also loads .env.search, for the search API keys (shared with the crypto engine; docs/SERVER.md §3.7).
#   • Dashboard (Vercel): the SHARED and DASHBOARD values go into the Vercel project's
#     Settings → Environment Variables (docs/SERVER.md lists them). Vercel can't read this file.
#   • Local dev: `pnpm dev:stock-engine` and `pnpm dev:stock-web` read .env.stock, then .env.stock.local
#     (git-ignored overrides, e.g. MONGODB_DB_NAME=stockmarketbot_dev and no DISCORD_WEBHOOK_URL).
#
# Generate secrets with:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep each value on one line, without trailing spaces. Put a value that contains $ in single quotes
# ('like$this'): compose would otherwise expand it, and local dev (node --env-file) reads it as-is.

# ─────────────────────────────────────────────────────────────────────────────
# SHARED (engine AND Vercel)
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection string: the Azure DocumentDB cluster (same cluster for the engine and the dashboard).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
MONGODB_DB_NAME=

# Signs the short-lived tokens browsers use to open the engine's live stream.
# Must be IDENTICAL on the server and on Vercel. 32+ characters. (Use a different one from CryptoMarketBot's.)
STREAM_TOKEN_SECRET=replace-with-64-hex-characters

# ─────────────────────────────────────────────────────────────────────────────
# ENGINE (engine only)
# ─────────────────────────────────────────────────────────────────────────────

# Alpaca PAPER trading keys. The engine only ever talks to Alpaca's paper endpoint, and it is the
# only thing that holds these keys (the dashboard reads MongoDB instead).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Your dashboard's origin(s), comma-separated. Browsers from any other site are refused.
STREAM_ALLOWED_ORIGINS=

# true when a reverse proxy sits in front of the engine (uses X-Forwarded-For for per-IP limits).
STREAM_TRUST_PROXY=true

# Optional: Discord channel webhook for warnings/errors, and the dashboard URL alerts link to.
DISCORD_WEBHOOK_URL=
DASHBOARD_URL=

LOG_LEVEL=info
# Every line also goes to logs/stock-engine/<UTC date>.log on the host (LOG_DIR=/logs, set in compose.yml,
# not here), which outlives the container. Unset (e.g. pnpm dev): stdout only.

# ── History store (docs/plans/LOCAL-AI.md §6) ────────────────────────────────
# This bot's own database on the history service: the closed 1-minute bars and the news archive.
# The password is STOCK_HISTORY_PASSWORD in .env.history (docs/SERVER.md §3.6). Unset: no history
# is kept; nothing else changes.
HISTORY_URL=postgres://stock_history:<STOCK_HISTORY_PASSWORD>@history:5432/stock_history

# ── News engine (docs/STOCK.md) ──────────────────────────────────────────────
# All free. A source whose key is empty stays off; nothing else breaks.
# The scraper sidecar's address (SCRAPER_URL=http://scraper:8790) is set in compose.yml,
# not here; without it the headless sources stay off. So is the local model server's (LLM_URL=http://llm:8080);
# without it, or without the scraper, there are no article summaries.

# Required by the SEC's fair-access policy ("Name contact-email"). Without it, EDGAR and SEC sources stay off.
SEC_USER_AGENT=StockMarketBot hello@colinfran.com

# Finnhub market/company news, earnings and IPO calendars, WebSocket trades: https://finnhub.io/register
FINNHUB_API_KEY=
# FRED macro data (release values): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# BLS macro data (CPI, jobs at release time): https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# openFDA (drug approvals). Optional: works without a key at lower limits. https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# Massive, formerly Polygon.io (news endpoint; free plan): massive.com → dashboard → API keys
MASSIVE_API_KEY=
# EIA (weekly oil and natural gas reports): https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ── Optional engine tuning (defaults shown) ─────────────────────────────────
# Used on FIRST boot only; afterwards change them on the dashboard's Admin page.
# STARTING_CAPITAL=10000
# ALPACA_DATA_FEED=iex          # "sip" needs a paid Alpaca data plan
# EVENT_RETENTION_DAYS=30
# STREAM_MAX_CLIENTS=100
# STREAM_PORT=8788              # CryptoMarketBot's engine uses 8787
# ENGINE_INSTANCE=windows-server

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD (Vercel only)
# ─────────────────────────────────────────────────────────────────────────────

# Better Auth secret: signs owner session cookies. 32+ characters. Changing it signs you out everywhere.
BETTER_AUTH_SECRET=replace-with-64-hex-characters

# Owner sign-in is a magic link (a code in the Home Screen app) emailed to this address; nobody else can sign in.
# Required, no default: without it nobody can sign in.
OWNER_EMAIL=

# Public URL of the dashboard (sign-in links point here; sign-in only works from this origin).
# Optional on Vercel: defaults to the project's production domain.
# SITE_URL=

# useSend sends the sign-in emails. All three are required, with no defaults.
# API key from your useSend dashboard → API keys.
USESEND_API_KEY=
# Base URL of your useSend instance, e.g. https://usesend.example.com
USESEND_BASE_URL=
# Verified sender, e.g. StockMarketBot <no-reply@example.com>
USESEND_FROM_EMAIL=

# Public WebSocket URL of the engine, through your reverse proxy (must be wss:// in production).
ENGINE_STREAM_URL=

# Optional: unhandled dashboard errors are posted to the same Discord channel.
# DISCORD_WEBHOOK_URL=

# Optional: the host agent's database on the same cluster, read by Admin → Server (default serverstats).
# HOST_DB_NAME=
