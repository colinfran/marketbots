# The engine images need the workspace manifests, packages/* and their own apps/<bot>-engine.
# The dashboard images (docker/web/Dockerfile) need their own apps/<bot>-web and the packages it uses.
# The scraper image needs apps/scraper only.
**/node_modules
**/.next
**/dist
**/coverage
**/*.tsbuildinfo
**/next-env.d.ts
.git
.vercel
# Real keys never enter a build context: compose passes them at runtime (environment, from .env).
*.env
.env
.env.*
docs
contracts
data
backups
logs
*.md
# The dashboards' tests don't go into their images, so a test-only change keeps the image as it is.
apps/crypto-web/tests
apps/stock-web/tests
apps/landing
apps/host-agent
