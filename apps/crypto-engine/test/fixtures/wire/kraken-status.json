   "incident_updates": [
    {
     "id": "w8fpxxrfrb3p",
     "status": "scheduled",
     "body": "We will be performing scheduled maintenance to our order entry system on Tuesday, October 27th, starting at approximately 10:00 UTC. This maintenance is expected to take up to 60 minutes.\n\nDuring this maintenance window, clients may experience the following:\n\n- Kraken Pro web, mobile, and desktop clients may experience a very small number of rejected order submissions or order modifications.\n- WebSocket API clients may experience a small number of rejected order submissions or order modifications, along with increased latency.\n- FIX API clients may experience several seconds during which order submissions and modifications are rejected, along with increased latency.\n\nNo action is required on your end. We will post an update once the maintenance has been completed.",
     "incident_id": "jdbk8wj1lvhz",
     "created_at": "2026-10-26T11:08:13.170Z",
