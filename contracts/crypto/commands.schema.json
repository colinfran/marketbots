{
  "command": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "pause"
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "resume"
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "kill_switch.engage"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "liquidate": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "reason",
          "liquidate"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "kill_switch.release"
          },
          "confirm": {
            "type": "string",
            "const": "RELEASE"
          }
        },
        "required": [
          "type",
          "confirm"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "strategy.set_enabled"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "trend",
              "daily_trend",
              "mean_reversion",
              "momentum",
              "event_driven",
              "discretionary"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "strategy",
          "enabled"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "settings.update"
          },
          "patch": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "type",
          "patch",
          "expected_version"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "cycle.run_now"
          },
          "symbols": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9]{2,12}\\/(USD|USDC|USDT)$"
            }
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "position.close"
          },
          "position_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "type",
          "position_id"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "paper.reset"
          },
          "confirm": {
            "type": "string",
            "const": "RESET"
          }
        },
        "required": [
          "type",
          "confirm"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "backtest.run"
          },
          "params": {
            "type": "object",
            "properties": {
              "symbols": {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{2,12}\\/(USD|USDC|USDT)$"
                }
              },
              "strategies": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "trend",
                    "mean_reversion",
                    "momentum"
                  ]
                }
              },
              "interval": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 60
                  },
                  {
                    "type": "number",
                    "const": 240
                  },
                  {
                    "type": "number",
                    "const": 1440
                  }
                ]
              },
              "starting_usd": {
                "type": "number",
                "minimum": 100,
                "maximum": 10000000
              },
              "slippage_bps": {
                "type": "number",
                "minimum": 0,
                "maximum": 200
              },
              "fee_bps": {
                "type": "number",
                "minimum": 0,
                "maximum": 200
              },
              "in_sample_fraction": {
                "type": "number",
                "minimum": 0.3,
                "maximum": 0.9
              }
            },
            "required": [
              "symbols",
              "strategies",
              "interval",
              "starting_usd",
              "slippage_bps",
              "fee_bps",
              "in_sample_fraction"
            ]
          }
        },
        "required": [
          "type",
          "params"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "seed.schedule"
          },
          "amount_usd": {
            "type": "number",
            "minimum": 100,
            "maximum": 10000
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "force": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "amount_usd",
          "at"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "seed.cancel"
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "wire.replay"
          },
          "item_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          }
        },
        "required": [
          "type",
          "item_id"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "agent.ask"
          },
          "question": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        },
        "required": [
          "type",
          "question"
        ]
      }
    ]
  },
  "backtest_params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "symbols": {
        "minItems": 1,
        "maxItems": 10,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,12}\\/(USD|USDC|USDT)$"
        }
      },
      "strategies": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "trend",
            "mean_reversion",
            "momentum"
          ]
        }
      },
      "interval": {
        "anyOf": [
          {
            "type": "number",
            "const": 60
          },
          {
            "type": "number",
            "const": 240
          },
          {
            "type": "number",
            "const": 1440
          }
        ]
      },
      "starting_usd": {
        "type": "number",
        "minimum": 100,
        "maximum": 10000000
      },
      "slippage_bps": {
        "type": "number",
        "minimum": 0,
        "maximum": 200
      },
      "fee_bps": {
        "type": "number",
        "minimum": 0,
        "maximum": 200
      },
      "in_sample_fraction": {
        "type": "number",
        "minimum": 0.3,
        "maximum": 0.9
      }
    },
    "required": [
      "symbols",
      "strategies",
      "interval",
      "starting_usd",
      "slippage_bps",
      "fee_bps",
      "in_sample_fraction"
    ]
  },
  "labels": {
    "pause": "Pause trading",
    "resume": "Resume trading",
    "kill_switch.engage": "Engage kill switch",
    "kill_switch.release": "Release kill switch",
    "strategy.set_enabled": "Toggle strategy",
    "settings.update": "Update settings",
    "cycle.run_now": "Run cycle now",
    "position.close": "Close position",
    "paper.reset": "Reset paper wallet",
    "backtest.run": "Run backtest",
    "seed.schedule": "Schedule seed buy",
    "seed.cancel": "Cancel seed buy",
    "wire.replay": "Replay news item",
    "agent.ask": "Ask the agent"
  },
  "backtest_intervals": [
    60,
    240,
    1440
  ],
  "backtest_strategies": [
    "trend",
    "mean_reversion",
    "momentum"
  ]
}
