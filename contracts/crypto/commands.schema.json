{
  "command": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "pause"
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "resume"
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "kill_switch.engage"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "liquidate": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "reason",
          "liquidate"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "kill_switch.release"
          },
          "confirm": {
            "type": "string",
            "const": "RELEASE"
          }
        },
        "required": [
          "type",
          "confirm"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "strategy.set_enabled"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "trend",
              "daily_trend",
              "mean_reversion",
              "momentum",
              "event_driven",
              "discretionary"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "strategy",
          "enabled"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "settings.update"
          },
          "patch": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "type",
          "patch",
          "expected_version"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "position.close"
          },
          "position_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "type",
          "position_id"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "paper.reset"
          },
          "confirm": {
            "type": "string",
            "const": "RESET"
          }
        },
        "required": [
          "type",
          "confirm"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "wire.replay"
          },
          "item_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          }
        },
        "required": [
          "type",
          "item_id"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "agent.ask"
          },
          "question": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        },
        "required": [
          "type",
          "question"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "agent.review"
          },
          "symbols": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9./-]{1,20}$"
            }
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "agent.resume_entries"
          }
        },
        "required": [
          "type"
        ]
      }
    ]
  },
  "labels": {
    "pause": "Pause trading",
    "resume": "Resume trading",
    "kill_switch.engage": "Engage kill switch",
    "kill_switch.release": "Release kill switch",
    "strategy.set_enabled": "Toggle strategy",
    "settings.update": "Update settings",
    "position.close": "Close position",
    "paper.reset": "Reset paper wallet",
    "wire.replay": "Replay news item",
    "agent.ask": "Ask the agent",
    "agent.review": "Wake the agent",
    "agent.resume_entries": "Resume the agent's entries"
  }
}
