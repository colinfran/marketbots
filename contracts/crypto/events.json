  "ephemeral": [
    "market.ticker",
    "engine.heartbeat",
    "research.progress",
    "ai.decision.progress",
    "ai.reasoning"
  ],
  "envelope_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "v": {
        "type": "number"
      },
      "seq": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "ts": {
        "type": "string"
      },
      "type": {
        "type": "string"
      },
      "level": {
        "type": "string",
        "enum": [
          "debug",
          "info",
          "warn",
          "error"
        ]
      },
      "visibility": {
        "type": "string",
        "enum": [
          "public",
          "owner"
        ]
      },
      "summary": {
        "type": "string"
      },
      "instrument": {
        "type": "string"
      },
      "cycle_id": {
        "type": "string"
      },
      "data": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "required": [
      "v",
      "seq",
      "ts",
      "type",
      "level",
      "visibility",
      "summary",
      "data"
    ]
  },
  "client_frame_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "auth"
          },
          "token": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          },
          "since": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "type",
          "token"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "pong"
          },
          "t": {
            "type": "number"
          }
        },
        "required": [
          "type"
        ]
      }
    ]
  }
}
