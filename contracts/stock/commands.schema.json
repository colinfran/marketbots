{
  "command": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "pause"
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "resume"
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "kill_switch.engage"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "liquidate": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "reason",
          "liquidate"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "kill_switch.release"
          },
          "confirm": {
            "type": "string",
            "const": "RELEASE"
          }
        },
        "required": [
          "type",
          "confirm"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "settings.update"
          },
          "patch": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "type",
          "patch",
          "expected_version"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "position.close"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z][A-Z.]{0,9}$"
          }
        },
        "required": [
          "type",
          "symbol"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "option.close"
          },
          "structure_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "type",
          "structure_id"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "broker.sync"
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "wire.replay"
          },
          "item_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          }
        },
        "required": [
          "type",
          "item_id"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "agent.ask"
          },
          "question": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        },
        "required": [
          "type",
          "question"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "agent.review"
          },
          "symbols": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9./-]{1,20}$"
            }
          }
        },
        "required": [
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "agent.resume_entries"
          }
        },
        "required": [
          "type"
        ]
      }
    ]
  },
  "labels": {
    "pause": "Pause trading",
    "resume": "Resume trading",
    "kill_switch.engage": "Engage kill switch",
    "kill_switch.release": "Release kill switch",
    "settings.update": "Update settings",
    "position.close": "Close stock position",
    "option.close": "Close options position",
    "broker.sync": "Sync with Alpaca",
    "wire.replay": "Replay news item",
    "agent.ask": "Ask the agent",
    "agent.review": "Wake the agent",
    "agent.resume_entries": "Resume the agent's entries"
  }
}
