            "type": "object",
            "properties": {
              "price_z": {
                "type": "number",
                "minimum": 2,
                "maximum": 20
              },
              "volume_multiple": {
                "type": "number",
                "minimum": 1.5,
                "maximum": 50
              },
              "market_z": {
                "type": "number",
                "minimum": 2,
                "maximum": 20
              }
            },
            "required": [
              "price_z",
              "volume_multiple",
              "market_z"
            ]
          },
          "disabled_sources": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "retention_days": {
            "type": "integer",
            "minimum": 7,
            "maximum": 730
          },
          "odds_swing_pts": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
