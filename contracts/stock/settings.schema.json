            "type": "number",
            "minimum": 0,
            "maximum": 90
          },
          "band_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 50
          },
          "min_holdings": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "max_holdings": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "max_holding_pct": {
            "type": "number",
            "minimum": 1,
            "maximum": 50
          },
          "max_index_etf_pct": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "max_theme_pct": {
            "type": "number",
            "minimum": 10,
            "maximum": 100
          },
          "stop_pct": {
            "type": "number",
            "minimum": 3,
            "maximum": 50
