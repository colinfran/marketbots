              "mon",
              "tue",
              "wed",
              "thu",
              "fri"
            ]
          },
          "review_time_et": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "universe_size": {
            "type": "integer",
            "minimum": 20,
            "maximum": 500
          },
          "themes": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "required": [
          "enabled",
          "target_pct",
          "band_pct",
          "min_holdings",
          "max_holdings",
          "max_holding_pct",
          "max_index_etf_pct",
          "max_theme_pct",
          "stop_pct",
          "min_conviction",
          "max_trades_per_review",
          "review_weekday",
          "review_time_et",
          "universe_size",
          "themes"
        ]
      }
    },
    "required": [
      "account",
      "risk",
      "options",
      "ai",
      "schedule",
      "universe",
      "wire",
      "core"
    ]
