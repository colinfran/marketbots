                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "max_per_hour": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              },
              "skip_domains": {
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
                }
              },
              "pause_hours": {
                "maxItems": 24,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^([01]?\\d|2[0-3])-([01]?\\d|2[0-4])$"
                }
              }
            },
            "required": [
              "enabled",
              "model",
              "min_severity",
              "max_per_hour",
              "skip_domains",
              "pause_hours"
            ]
          }
