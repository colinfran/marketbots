              "research": {
                "type": "string",
                "pattern": "^[a-z0-9-]+\\/[a-z0-9][a-z0-9.\\-]*$"
              },
              "decision": {
                "type": "string",
                "pattern": "^[a-z0-9-]+\\/[a-z0-9][a-z0-9.\\-]*$"
              },
              "fallback": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+\\/[a-z0-9][a-z0-9.\\-]*$"
