# marketbots configuration: copy this file to `.env` at the repo root (git-ignored) and fill it in.
#
# One file holds every secret and setting of the stack (docs/SERVER.md §3), in sections:
#   SHARED    no prefix: the same value for both bots (and HOST_API_SECRET for the host agent)
#   CRYPTO    CRYPTO_*:  the crypto engine and dashboard only
#   STOCK     STOCK_*:   the stock engine and dashboard only
#   HISTORY   HISTORY_*: the history store's passwords
#   MONGO     MONGO_*:   the stack's MongoDB passwords
#   SEARCH    the search service's proxy
#   HOST      the host agent on the Windows server (outside Docker)
#
# Who reads what:
#   • Docker: compose reads this file by itself, and compose.yml hands each container only its own
#     variables, under the names its code reads (CRYPTO_MONGODB_DB_NAME becomes the crypto engine's
#     MONGODB_DB_NAME). compose.yml also sets the stack's own addresses (STREAM_HOST, STREAM_PORT,
#     SCRAPER_URL, LLM_URL, SEARCH_URL, LOG_DIR, ENGINE_URL, HOST_API_URL) and builds each service's
#     MONGODB_URI and HISTORY_URL from the passwords below.
#     A new variable goes here AND into the environment of each service that reads it in compose.yml.
#   • Dashboards: their containers (compose.yml crypto-web, stock-web) get the variables marked
#     "dashboard" the same way, under their names without the prefix (docs/SERVER.md §3.4 lists them).
#   • Local dev: `pnpm dev:<bot>-engine` and `pnpm dev:<bot>-web` read this file, then .env.local
#     (git-ignored overrides, docs/SERVER.md §3.5), with the same renaming as compose.
#   • Host agent: reads this file directly (node --env-file); it uses HOST_API_SECRET and the HOST section.
#
# Generate secrets with:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep each value on one line, without trailing spaces. Put a value that contains $, spaces or # in
# single quotes ('like$this'): compose would otherwise expand the $, and single quotes keep it literal
# for compose and for Node alike.

# ═════════════════════════════════════════════════════════════════════════════
# SHARED: both bots
# ═════════════════════════════════════════════════════════════════════════════

# MongoDB for local dev only (`pnpm dev:*`): the stack's mongo-dev (docker compose --profile dev up -d
# mongo-dev). The live engines and dashboards don't read it: compose builds theirs for the stack's own
# `mongo` from the MONGO section's passwords.
MONGODB_URI=mongodb://127.0.0.1:27018/?directConnection=true

# ── News engines (docs/CRYPTO.md, docs/STOCK.md) ────────────────────────────
# All free. A source whose key is empty stays off; nothing else breaks.

# Required by the SEC's fair-access policy ("Name contact-email"). Without it, EDGAR and SEC sources stay off.
SEC_USER_AGENT=
# Finnhub market and company news, calendars, WebSocket trades: https://finnhub.io/register
FINNHUB_API_KEY=
# FRED macro data (release values): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# BLS macro data (CPI, jobs at release time): https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# ── Research's search APIs (docs/SERVER.md §3.7, §9) ────────────────────────
# Free monthly allowances, one key each for both bots, paced evenly through the month.
# A provider whose key is empty isn't asked.
# Tavily (https://app.tavily.com): 1,000 credits a month.
TAVILY_API_KEY=
# Exa (https://dashboard.exa.ai): $10 of credit a month.
EXA_API_KEY=
# Bright Data (https://brightdata.com/cp): 5,000 SERP requests a month, through a SERP zone
# (BRIGHTDATA_ZONE; empty: serp_api1).
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# ── Dashboards (their containers, and local dev) ────────────────────────────
# Owner sign-in is a magic link (a code in the Home Screen app) emailed to this address; nobody else can sign in.
# Required, no default: without it nobody can sign in.
OWNER_EMAIL=

# useSend sends the sign-in emails (with each bot's USESEND_FROM_EMAIL). Required, no defaults.
# API key from your useSend dashboard → API keys.
USESEND_API_KEY=
# Base URL of your useSend instance, e.g. https://usesend.example.com
USESEND_BASE_URL=

# Time zone for timestamps on the dashboards.
NEXT_PUBLIC_DISPLAY_TIMEZONE=America/Los_Angeles

# Admin → Server reads the host agent's API (docs/SERVER.md §11). The secret is the same for the agent and
# both dashboards (32+ characters). HOST_API_URL is for local dev, the agent's own address; compose
# gives the dashboards' containers http://host.docker.internal:8789. Without both, Admin → Server shows
# the agent offline.
HOST_API_SECRET=
HOST_API_URL=http://127.0.0.1:8789

# ═════════════════════════════════════════════════════════════════════════════
# CRYPTO: CryptoMarketBot
# ═════════════════════════════════════════════════════════════════════════════

# ── Engine and dashboard ─────────────────────────────────────────────────────
CRYPTO_MONGODB_DB_NAME=cryptomarketbot

# Signs the short-lived tokens browsers use to open the engine's live stream.
# compose gives the engine and the dashboard the same value. 32+ characters. (A different one from StockMarketBot's.)
CRYPTO_STREAM_TOKEN_SECRET=replace-with-64-hex-characters

# Optional: the engine's Discord channel webhook for warnings/errors. The dashboard posts its
# unhandled errors to the same channel.
CRYPTO_DISCORD_WEBHOOK_URL=

# ── Engine ───────────────────────────────────────────────────────────────────
# Your dashboard's origin(s), comma-separated. Browsers from any other site are refused.
CRYPTO_STREAM_ALLOWED_ORIGINS=https://cryptomarketbot.app

# true when a reverse proxy sits in front of the engine (uses X-Forwarded-For for per-IP limits).
CRYPTO_STREAM_TRUST_PROXY=true

# Kraken CLI paper workspace name (lowercase, digits, dashes). The wallet lives in the
# `kraken-paper` Docker volume. No Kraken API keys are needed or used.
CRYPTO_KRAKEN_WORKSPACE=cryptomarketbot

# Optional: the dashboard URL alerts link to.
CRYPTO_DASHBOARD_URL=https://cryptomarketbot.app

CRYPTO_LOG_LEVEL=info
# Every line also goes to logs/crypto-engine/<UTC date>.log on the host (LOG_DIR, set in compose.yml),
# which outlives the container. Local dev: stdout only.

# CoinGecko Demo plan (trending, movers): https://www.coingecko.com/en/developers/dashboard
CRYPTO_COINGECKO_API_KEY=
# Etherscan (gas, network stress): https://etherscan.io/myapikey
CRYPTO_ETHERSCAN_API_KEY=
# Coinalyze (funding, open interest, liquidations across exchanges): coinalyze.net → account → API key
CRYPTO_COINALYZE_API_KEY=

# Optional tuning (defaults shown):
# CRYPTO_EVENT_RETENTION_DAYS=30
# CRYPTO_KRAKEN_CLI_TIMEOUT_MS=20000
# CRYPTO_STREAM_MAX_CLIENTS=100
# CRYPTO_ENGINE_INSTANCE=windows-server

# ── Dashboard (its container, and local dev) ─────────────────────────────────
# Better Auth secret: signs owner session cookies. 32+ characters. Changing it signs you out everywhere.
# (A different one from StockMarketBot's.)
CRYPTO_BETTER_AUTH_SECRET=replace-with-64-hex-characters

# Public WebSocket URL of the engine, through your reverse proxy (must be wss:// in production).
CRYPTO_ENGINE_STREAM_URL=wss://engine.your-domain.com/v1/stream

# Verified sender of the sign-in emails, e.g. CryptoMarketBot <no-reply@example.com> (in single quotes).
CRYPTO_USESEND_FROM_EMAIL=

# Public URL of the dashboard (sign-in links point here; sign-in only works from this origin).
# Optional: compose defaults it to the bot's domain.
# CRYPTO_SITE_URL=https://cryptomarketbot.app

# ═════════════════════════════════════════════════════════════════════════════
# STOCK: StockMarketBot
# ═════════════════════════════════════════════════════════════════════════════

# ── Engine and dashboard ─────────────────────────────────────────────────────
STOCK_MONGODB_DB_NAME=stockmarketbot

# Signs the short-lived tokens browsers use to open the engine's live stream.
# compose gives the engine and the dashboard the same value. 32+ characters. (A different one from CryptoMarketBot's.)
STOCK_STREAM_TOKEN_SECRET=replace-with-64-hex-characters

# Optional: the engine's Discord channel webhook for warnings/errors. The dashboard posts its
# unhandled errors to the same channel.
STOCK_DISCORD_WEBHOOK_URL=

# ── Engine ───────────────────────────────────────────────────────────────────
# Alpaca PAPER trading keys. The engine only ever talks to Alpaca's paper endpoint, and it is the
# only thing that holds these keys (the dashboard reads MongoDB instead).
STOCK_ALPACA_API_KEY=
STOCK_ALPACA_SECRET_KEY=

# Your dashboard's origin(s), comma-separated. Browsers from any other site are refused.
STOCK_STREAM_ALLOWED_ORIGINS=

# true when a reverse proxy sits in front of the engine (uses X-Forwarded-For for per-IP limits).
STOCK_STREAM_TRUST_PROXY=true

# Optional: the dashboard URL alerts link to.
STOCK_DASHBOARD_URL=

STOCK_LOG_LEVEL=info
# Every line also goes to logs/stock-engine/<UTC date>.log on the host (LOG_DIR, set in compose.yml),
# which outlives the container. Local dev: stdout only.

# openFDA (drug approvals). Optional: works without a key at lower limits. https://open.fda.gov/apis/authentication/
STOCK_OPENFDA_API_KEY=
# Massive, formerly Polygon.io (news endpoint; free plan): massive.com → dashboard → API keys
STOCK_MASSIVE_API_KEY=
# EIA (weekly oil and natural gas reports): https://www.eia.gov/opendata/register.php
STOCK_EIA_API_KEY=

# Optional tuning (defaults shown). The first two are used on FIRST boot only; afterwards change
# them on the dashboard's Admin page.
# STOCK_STARTING_CAPITAL=10000
# STOCK_ALPACA_DATA_FEED=iex          # "sip" needs a paid Alpaca data plan
# STOCK_EVENT_RETENTION_DAYS=30
# STOCK_STREAM_MAX_CLIENTS=100
# STOCK_ENGINE_INSTANCE=windows-server

# ── Dashboard (its container, and local dev) ─────────────────────────────────
# Better Auth secret: signs owner session cookies. 32+ characters. Changing it signs you out everywhere.
# (A different one from CryptoMarketBot's.)
STOCK_BETTER_AUTH_SECRET=replace-with-64-hex-characters

# Public WebSocket URL of the engine, through your reverse proxy (must be wss:// in production).
STOCK_ENGINE_STREAM_URL=

# Verified sender of the sign-in emails, e.g. StockMarketBot <no-reply@example.com> (in single quotes).
STOCK_USESEND_FROM_EMAIL=

# Public URL of the dashboard (sign-in links point here; sign-in only works from this origin).
# Optional: compose defaults it to the bot's domain.
# STOCK_SITE_URL=https://stockmarketbot.app

# ═════════════════════════════════════════════════════════════════════════════
# HISTORY: the history store's passwords (docs/SERVER.md §3.6)
# ═════════════════════════════════════════════════════════════════════════════
# They take effect only when the history volume is created (the first start); after that, changing
# one here changes nothing until it is changed in Postgres too. compose builds each engine's
# HISTORY_URL from its bot's password, so an engine can reach only its own database.

# The Postgres superuser (used only to create the databases and by the nightly backup).
HISTORY_POSTGRES_PASSWORD=
# The crypto_history role: the crypto engine's history database.
HISTORY_CRYPTO_PASSWORD=
# The stock_history role: the stock engine's history database.
HISTORY_STOCK_PASSWORD=

# ═════════════════════════════════════════════════════════════════════════════
# MONGO: the stack's MongoDB passwords (docs/SERVER.md §3.8)
# ═════════════════════════════════════════════════════════════════════════════
# docker/mongo/init.js creates a user with each (it runs once per new volume; run it again after
# changing one, then recreate what uses it). compose builds each service's MONGODB_URI from its own,
# so an engine reaches only its own database and a dashboard only reads its bot's. Hex, like the
# other secrets: they go into URLs as they are.

# root: init.js and maintenance by hand (docker compose exec mongo mongosh).
MONGO_ROOT_PASSWORD=
# Each engine's user: its own database, read and write.
MONGO_CRYPTO_ENGINE_PASSWORD=
MONGO_STOCK_ENGINE_PASSWORD=
# Each dashboard's user: reads its bot's database, writes only sign-ins and audit entries.
MONGO_CRYPTO_WEB_PASSWORD=
MONGO_STOCK_WEB_PASSWORD=
# mongo-backup's user (the backup role).
MONGO_BACKUP_PASSWORD=

# ═════════════════════════════════════════════════════════════════════════════
# SEARCH: the search service (docs/SERVER.md §3.7)
# ═════════════════════════════════════════════════════════════════════════════

# The residential proxy for the paid search engine, billed per GB, as
# http://<user>:<password>_country-US@core-residential.evomi.com:1000 (not the dashboard's
# host:port:user:password). Percent-encode special characters in the password.
# Empty: the paid engine goes direct, and our IP is blocked by it.
SEARCH_PROXY_URL=

# ═════════════════════════════════════════════════════════════════════════════
# HOST: the host agent (docs/SERVER.md §11). Nothing here goes to a container.
# ═════════════════════════════════════════════════════════════════════════════
# It runs on the Windows server itself, not in Docker: it reads the machine's CPU, GPUs, RAM, disks,
# fans and outlet power for Admin → Server in both dashboards, and runs the motherboard fans. It keeps
# the readings on the server (a SQLite file in HOST_DATA_DIR) and serves them through its API
# (HOST_API_SECRET above); nothing goes to the database.

# on: the agent sets the motherboard CPU/case fans (Admin → Server → Fans); off: it only reads them.
# Never on while another fan-control app (the old Jellyfin System Monitor, a vendor tool) runs.
FAN_CONTROL=off

# VeSync energy-monitoring outlet (optional): an account that sees the outlet. Without it, no power or energy.
# VeSync's API is unofficial; a separate account the outlet (or home) is shared with keeps this apart from
# your own (accept the share in the VeSync app, signed in as that account).
VESYNC_USERNAME=
VESYNC_PASSWORD=
# The account's time zone (default: the server's) and country (default US).
# VESYNC_TIMEZONE=America/Los_Angeles
# VESYNC_COUNTRY_CODE=US
# How often the outlet is read, in ms: 15000–3600000 (default 60000).
# VESYNC_REFRESH_MS=60000

# Advanced, leave these commented out: the defaults are what the install scripts and Caddy expect.
# The API's port on 127.0.0.1 (default 8789); the dashboards' containers reach it through host.docker.internal.
# HOST_API_PORT=8789
# Where the agent keeps its files (LibreHardwareMonitor, settings, fan settings, the readings' host.sqlite,
# logs). Default: apps/host-agent/data.
# HOST_DATA_DIR=
# LibreHardwareMonitor's connection file, written by scripts/install-sensors.ps1. Default: <HOST_DATA_DIR>/lhm.json.
# LHM_CONNECTION_FILE=
