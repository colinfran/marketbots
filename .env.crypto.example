# CryptoMarketBot configuration: copy this file to `.env.crypto` at the repo root (git-ignored) and fill it in.
#
# One file holds everything the crypto engine and the crypto dashboard read:
#   • Engine (trading server): compose.yml loads .env.crypto into the crypto-engine container (env_file).
#     compose.yml itself sets STREAM_HOST, STREAM_PORT, SCRAPER_URL and LLM_URL.
#   • Dashboard (Vercel): the SHARED and DASHBOARD values go into the Vercel project's
#     Settings → Environment Variables (docs/SERVER.md lists them). Vercel can't read this file.
#   • Local dev: `pnpm dev:crypto-engine` and `pnpm dev:crypto-web` read .env.crypto, then .env.crypto.local
#     (git-ignored overrides, e.g. MONGODB_DB_NAME=cryptomarketbot_dev and no DISCORD_WEBHOOK_URL).
#
# Generate secrets with:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep each value on one line, without trailing spaces. Put a value that contains $ in single quotes
# ('like$this'): compose would otherwise expand it, and local dev (node --env-file) reads it as-is.

# ─────────────────────────────────────────────────────────────────────────────
# SHARED (engine AND Vercel)
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (same cluster for the engine and the dashboard).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cryptomarketbot

# Signs the short-lived tokens browsers use to open the engine's live stream.
# Must be IDENTICAL on the server and on Vercel. 32+ characters.
STREAM_TOKEN_SECRET=replace-with-64-hex-characters

# ─────────────────────────────────────────────────────────────────────────────
# ENGINE (engine only)
# ─────────────────────────────────────────────────────────────────────────────

# Vercel AI Gateway key (Grok is called through the gateway, like stockmarketbot).
# Without it the engine still runs and protects positions, but makes no AI decisions.
AI_GATEWAY_API_KEY=

# Your dashboard's origin(s), comma-separated. Browsers from any other site are refused.
STREAM_ALLOWED_ORIGINS=https://your-dashboard.vercel.app

# true when a reverse proxy sits in front of the engine (uses X-Forwarded-For for per-IP limits).
STREAM_TRUST_PROXY=true

# Kraken CLI paper workspace name (lowercase, digits, dashes). The wallet lives in the
# `kraken-paper` Docker volume. No Kraken API keys are needed or used.
KRAKEN_WORKSPACE=cryptomarketbot

# Optional: Discord channel webhook for warnings/errors, and the dashboard URL alerts link to.
DISCORD_WEBHOOK_URL=
DASHBOARD_URL=https://your-dashboard.vercel.app

LOG_LEVEL=info
# Every line also goes to logs/crypto-engine/<UTC date>.log on the host (LOG_DIR=/logs, set in compose.yml,
# not here), which outlives the container. Unset (e.g. pnpm dev): stdout only.

# ── History store (docs/plans/LOCAL-AI.md §6) ────────────────────────────────
# This bot's own database on the history service: the closed 1-minute bars and the news archive.
# The password is CRYPTO_HISTORY_PASSWORD in .env.history (docs/SERVER.md §3.6). Unset: no history
# is kept; nothing else changes.
HISTORY_URL=postgres://crypto_history:<CRYPTO_HISTORY_PASSWORD>@history:5432/crypto_history

# ── News engine (docs/CRYPTO.md) ─────────────────────────────────────────────
# All free. A source whose key is empty stays off; nothing else breaks.
# The scraper sidecar's address (SCRAPER_URL=http://scraper:8790) is set in compose.yml,
# not here; without it the headless sources stay off. So is the local LLM's (LLM_URL=http://llm:11434);
# without it, or without the scraper, there are no article summaries.

# Required by the SEC's fair-access policy ("Name contact-email"). Without it, SEC sources stay off.
SEC_USER_AGENT=CryptoMarketBot hello@colinfran.com

# Finnhub crypto/market news: https://finnhub.io/register
FINNHUB_API_KEY=
# FRED macro data (release values): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# BLS macro data (CPI, jobs at release time): https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# CoinGecko Demo plan (trending, movers): https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=
# Etherscan (gas, network stress): https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# Coinalyze (funding, open interest, liquidations across exchanges): coinalyze.net → account → API key
COINALYZE_API_KEY=

# ── Optional engine tuning (defaults shown) ─────────────────────────────────
# Models used on FIRST boot only; afterwards change them on the dashboard's Admin page.
# GROK_RESEARCH_MODEL=spacexai/grok-4.5
# GROK_DECISION_MODEL=spacexai/grok-4.7
# EVENT_RETENTION_DAYS=30
# KRAKEN_CLI_TIMEOUT_MS=20000
# STREAM_MAX_CLIENTS=100
# BACKTEST_DATA_DIR=/data/ohlc
# ENGINE_INSTANCE=windows-server

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD (Vercel only)
# ─────────────────────────────────────────────────────────────────────────────

# Better Auth secret: signs owner session cookies. 32+ characters. Changing it signs you out everywhere.
BETTER_AUTH_SECRET=replace-with-64-hex-characters

# Owner sign-in is a magic link (a code in the Home Screen app) emailed to this address; nobody else can sign in.
# Optional: defaults to colin.franceschini@gmail.com.
# OWNER_EMAIL=colin.franceschini@gmail.com

# Public URL of the dashboard (sign-in links point here; sign-in only works from this origin).
# Optional on Vercel: defaults to the project's production domain.
# SITE_URL=https://crypto.your-domain.com

# useSend sends the sign-in emails. API key from your useSend dashboard → API keys.
USESEND_API_KEY=
# Base URL of your useSend instance. Optional: defaults to https://franceschini.email.
# USESEND_BASE_URL=https://franceschini.email
# Verified sender. Optional: defaults to CryptoMarketBot <no-reply@email.com>.
# USESEND_FROM_EMAIL=CryptoMarketBot <no-reply@email.com>

# Public WebSocket URL of the engine, through your reverse proxy (must be wss:// in production).
ENGINE_STREAM_URL=wss://engine.your-domain.com/v1/stream

# Time zone for timestamps on the dashboard.
NEXT_PUBLIC_DISPLAY_TIMEZONE=America/Los_Angeles
